# Copia este archivo como .env y llena los valores reales
# NUNCA subas el archivo .env al repositorio

# JSONBin - API Key (obtenla en https://jsonbin.io → API Keys)
# Los $ deben escaparse con \ para que Vite los interprete correctamente
# Ejemplo: si tu clave es $2a$10$abc... escríbela como \$2a\$10\$abc...
VITE_JSONBIN_API_KEY=\$2a\$10\$your_master_key_here

# JSONBin - IDs de los bins
VITE_JSONBIN_BIN1_ID=6a16b569f47d5c455c3c4aa7
VITE_JSONBIN_BIN2_ID=6a16b5828ef04f453820891a
